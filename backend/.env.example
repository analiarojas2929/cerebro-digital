# Database
DATABASE_URL=postgresql://cerebro:cerebro123@localhost:5432/cerebro_digital
REDIS_URL=redis://localhost:6379/0

# Vector Database
CHROMA_PERSIST_DIR=./chroma_data

# API Keys (Opcional - para usar modelos externos)
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Application
APP_NAME=Cerebro Digital
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Neural Models
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CLASSIFIER_MODEL=distilbert-base-uncased

# Memory Settings
SHORT_TERM_MEMORY_SIZE=50
LONG_TERM_MEMORY_THRESHOLD=0.75
MAX_CONTEXT_LENGTH=2000
